generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_USER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum TenantPlan {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model Tenant {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  status            TenantStatus @default(TRIAL)
  plan              TenantPlan   @default(STARTER)
  deviceProvisionKey String      @map("device_provision_key")
  contactEmail      String?      @map("contact_email")
  contactPhone      String?      @map("contact_phone")
  
  // ERPNext Integration (Tenant-level)
  erpnextEnabled    Boolean      @default(false) @map("erpnext_enabled")
  erpnextUrl        String?      @map("erpnext_url")
  erpnextApiKey     String?      @map("erpnext_api_key")
  erpnextApiSecret  String?      @map("erpnext_api_secret")
  
  // Billing & Subscription
  billingCycle      BillingCycle @default(MONTHLY) @map("billing_cycle")
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  subscriptionStartDate DateTime? @map("subscription_start_date")
  subscriptionEndDate DateTime?  @map("subscription_end_date")
  nextBillingDate   DateTime?   @map("next_billing_date")
  monthlyPrice      Float       @default(0) @map("monthly_price")
  yearlyPrice       Float       @default(0) @map("yearly_price")
  
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  users            User[]
  devices          Device[]
  attendanceLogs   AttendanceLog[]
  employeeMappings EmployeeMapping[]
  rawEvents        DeviceRawEvent[]
  payments         Payment[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  deviceUsers      DeviceUser[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole
  tenantId     String?  @map("tenant_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

enum PunchType {
  BOTH
  IN_ONLY
  OUT_ONLY
}

model Device {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  serialNumber String    @map("serial_number")
  name         String?
  punchType    PunchType @default(BOTH) @map("punch_type")
  lastSeenAt   DateTime? @map("last_seen_at")
  lastIp       String?   @map("last_ip")
  firmware     String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([punchType])
  @@map("devices")
}

model AttendanceLog {
  id                String     @id @default(cuid())
  tenantId          String     @map("tenant_id")
  deviceSn          String     @map("device_sn")
  userPin           String     @map("user_pin")
  punchedAt         DateTime   @map("punched_at")
  status            Int?
  verifyType        Int?       @map("verify_type")
  inOutMode         Int?       @map("in_out_mode")
  workCode          Int?       @map("work_code")
  rawLine           String?    @map("raw_line")
  syncStatus        SyncStatus @default(PENDING) @map("sync_status")
  erpnextCheckinId  String?    @map("erpnext_checkin_id")
  syncedAt          DateTime?  @map("synced_at")
  syncError         String?    @map("sync_error")
  createdAt         DateTime   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceSn, userPin, punchedAt])
  @@index([tenantId, punchedAt])
  @@index([deviceSn])
  @@index([userPin])
  @@index([syncStatus])
  @@map("attendance_logs")
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

model EmployeeMapping {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  userPin           String   @map("user_pin")
  employeeName      String   @map("employee_name")
  erpnextEmployeeId String?  @map("erpnext_employee_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userPin])
  @@map("employee_mappings")
}

model DeviceUser {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  deviceSn      String   @map("device_sn")
  userPin       String   @map("user_pin")
  userName      String?  @map("user_name")
  privilege     Int?     // 0=User, 1=Manager, 2=Admin
  enabled       Boolean  @default(true)
  lastSyncedAt  DateTime @map("last_synced_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceSn, userPin])
  @@index([tenantId])
  @@index([deviceSn])
  @@map("device_users")
}

model DeviceRawEvent {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  deviceSn    String?  @map("device_sn")
  method      String
  path        String
  query       String?
  bodyPreview String?  @map("body_preview")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([deviceSn])
  @@index([createdAt])
  @@map("device_raw_events")
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  CARD
}

model Payment {
  id                  String        @id @default(cuid())
  tenantId            String        @map("tenant_id")
  invoiceId           String        @map("invoice_id")
  amount              Float
  currency            String        @default("BDT")
  method              PaymentMethod
  status              PaymentStatus @default(INITIATED)
  bkashPaymentId      String?       @map("bkash_payment_id")
  bkashTransactionId  String?       @map("bkash_transaction_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  completedAt         DateTime?     @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Subscription {
  id                String              @id @default(cuid())
  tenantId          String              @map("tenant_id")
  plan              TenantPlan
  billingCycle      BillingCycle
  status            SubscriptionStatus
  amount            Float
  currency          String              @default("BDT")
  startDate         DateTime            @map("start_date")
  endDate           DateTime?           @map("end_date")
  nextBillingDate   DateTime            @map("next_billing_date")
  autoRenew         Boolean             @default(true) @map("auto_renew")
  cancelledAt       DateTime?           @map("cancelled_at")
  cancelReason      String?             @map("cancel_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

model Invoice {
  id                String        @id @default(cuid())
  tenantId          String        @map("tenant_id")
  invoiceNumber     String        @map("invoice_number")
  amount            Float
  currency          String        @default("BDT")
  status            String        @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  billingPeriodStart DateTime     @map("billing_period_start")
  billingPeriodEnd  DateTime      @map("billing_period_end")
  dueDate           DateTime      @map("due_date")
  paidAt            DateTime?     @map("paid_at")
  description       String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}
